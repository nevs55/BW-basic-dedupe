# Vault data must never be committed.
# Every .json and .csv is ignored by default; the sample fixture is re-allowed
# at the bottom, since in gitignore the last matching rule wins.
*.json
*.csv

# Bitwarden's own export filenames, and anything that looks like one
bitwarden_export*
*export*.json
*vault*.json
vault-deduped-*.json
vault-delete-list-*.csv

# Other credential-bearing formats
*.1pux
*.opvault
*.kdbx
*.enc

# Editors, OS cruft, tooling
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
node_modules/
.env
.env.*

# The one exception: the test fixtures directory. Those files are synthetic and are
# referenced by tests/run-tests.py, so they are re-allowed at the bottom, where the last
# matching rule wins. Never add an export of a real vault here — see tests/fixtures/README.md.
!tests/fixtures/*.json
!tests/fixtures/*.txt
